# ── API Keys ──────────────────────────────────────────────────────────
# Financial Modeling Prep  https://financialmodelingprep.com/developer
# Free tier: 250 req/day; paid tiers unlock more endpoints
FMP_API_KEY=your_fmp_key_here

# Finnhub  https://finnhub.io/
# Free tier: 60 req/min
FINNHUB_API_KEY=your_finnhub_key_here

# SEC EDGAR — no key required (public API, rate-limit: 10 req/s)
# yfinance  — no key required

# MarketData.app  https://www.marketdata.app/
# Powers the 期权分析 / Bull Put Spread option chain pages (scoring/options_chain.py)
MARKETDATA_API_KEY=your_marketdata_key_here

# FRED (Federal Reserve Economic Data)  https://fred.stlouisfed.org/docs/api/api_key.html
# Free, official ACTUAL macro data only (CPI/Core CPI/PCE/Core PCE/unemployment/
# nonfarm payrolls) -- scoring/macro_data.py. Does NOT provide consensus/expected
# values for these releases; no free source does.
FRED_API_KEY=your_fred_key_here

# ── Optional tuning ────────────────────────────────────────────────────
# Hours before cached API responses are considered stale
CACHE_TTL_HOURS=24

# Max parallel workers for network fetching
MAX_WORKERS=8
