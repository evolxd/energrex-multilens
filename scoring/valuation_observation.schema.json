{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energrex.local/schemas/valuation-observation-v1.json",
  "title": "ENERGREX Valuation Source Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field",
    "value",
    "unit",
    "source",
    "source_type",
    "source_family",
    "origin_family",
    "lineage_id",
    "source_locator",
    "observed_at",
    "available_at",
    "retrieved_at",
    "extraction_method"
  ],
  "properties": {
    "field": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["PRIMARY", "MARKET", "CONSENSUS", "MODEL"]
    },
    "source_family": {"type": "string", "minLength": 1},
    "origin_family": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "extraction_method": {"type": "string", "minLength": 1}
  }
}
